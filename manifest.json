{
   "action": {
      "default_popup": "popup.html",
      "default_title": "YT Silence Cutter"
   },
   "author": "pavnxet",
   "background": {
      "service_worker": "background.js"
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "yt-silence-cutter@pavnxet"
      }
   },
   "content_scripts": [ {
      "js": [ "chunks/smooth-core.js", "content-scripts/content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   } ],
   "description": "Automatically fast-forwards the silent and low-volume parts of any video you watch.",
   "homepage_url": "https://github.com/pavnxet/yt-silence-cutter",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "96": "icon/96.png"
   },
   "manifest_version": 3,
   "name": "YT Silence Cutter",
   "permissions": [ "storage" ],
   "version": "1.5.0"
}
